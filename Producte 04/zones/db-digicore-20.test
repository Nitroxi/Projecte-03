;
; BIND data file for local loopback interface
;
$TTL	604800
@	IN	SOA	ns1.digicore-20.test. usuari.digicore-20.test (
			      2		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			 604800 )	; Negative Cache TTL
;
	  	 IN	NS	ns1.digicore-20.test.
ns1	 	 IN	A	192.168.4.20
server	 IN	A	192.168.4.20
dbserver IN	A	192.168.4.100
data	 IN	CNAME	dbserver.digicore-20.test.
